# Copy to the repository root as `.env` to override any of the defaults.
# compose.yaml works without this file.

# Which engine the forum runs on: mysql (default) or postgresql.
# Both database services start either way. This only decides what the generated
# Settings.php points at, so it has no effect once the forum is installed --
# Settings.php wins from then on. To move an existing install, delete
# Settings.php and Settings_bak.php and restart, or run
# .docker/baseline/reset.sh.
SMF_DB_TYPE=mysql

# Host ports. Offset from the SMF 3.0 environment (8080/8081/8025/3307/5433) so
# both stacks can run at once.
WEB_PORT=8180
ADMINER_PORT=8181
MAILPIT_PORT=8125
MYSQL_PORT=3407
POSTGRES_PORT=5533

# Versions.
#   PHP:      2.1 supports 7.1-8.4; 8.2 is quiet, 8.3+ adds deprecation noise.
#   MySQL:    do not move to 9.x -- it drops the utf8/utf8mb3 aliases 2.1 uses.
#   Postgres: matches the 3.0 environment on purpose.
PHP_VERSION=8.2
MYSQL_VERSION=8.4
POSTGRES_VERSION=17-alpine

# Database credentials (dev only). Shared by both engines so that switching
# SMF_DB_TYPE needs no other change.
DB_NAME=smf
DB_USER=smf
DB_PASSWORD=smf
DB_ROOT_PASSWORD=smf

# Forum name written into the generated Settings.php.
SMF_MBNAME=SMF 2.1 Baseline

# Which service Adminer pre-fills in its server field. Service name, not engine
# name: mysql or postgres.
ADMINER_SERVER=mysql

# Baseline generator (.docker/baseline/). The scripts have these built in;
# setting them here only overrides. Changing the admin credentials changes what
# ends up in the committed dumps, so keep them unless you are regenerating.
#BASELINE_ADMIN_USER=admin
#BASELINE_ADMIN_PASS=baseline
#BASELINE_ADMIN_EMAIL=admin@localhost
#BASELINE_VERSION=2.1.7-1
#BASELINE_PROFILE=small
