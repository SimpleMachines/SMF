# Copy to the repository root as `.env` to override any of the defaults.
# compose.yaml works without this file.

# Host ports
WEB_PORT=8080
ADMINER_PORT=8081
MAILPIT_PORT=8025
POSTGRES_PORT=5433

# Versions
PHP_VERSION=8.4
POSTGRES_VERSION=17-alpine

# Database credentials (dev only)
POSTGRES_DB=smf
POSTGRES_USER=smf
POSTGRES_PASSWORD=smf
